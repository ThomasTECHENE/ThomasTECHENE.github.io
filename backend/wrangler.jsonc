{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "policheatsheat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carnet-des-savoirs",
      "database_id": "6d0a97fd-46ac-4426-b70d-46819b73a0c3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "policheatsheet-assets"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://politcheatsheet.github.io,https://politcheatsheet.mytho123.ovh"
  }
}
