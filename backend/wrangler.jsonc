{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carnet-des-savoirs-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "carnet-des-savoirs",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://thomastechene.github.io"
  }
}
